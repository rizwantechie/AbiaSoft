<!-- Quote Start -->
<div class="container-fluid py-4 wow fadeInUp" data-wow-delay="0.1s" id="quote">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7">
                <div class="section-title position-relative pb-3 mb-5">
                    <h5 class="fw-bold text-primary text-uppercase">Request A Quote</h5>
                    <h1 class="mb-0">Need A Free Quote? Please Feel Free to Contact Us</h1>
                </div>
                <div class="row gx-3">
                    <div class="col-sm-6 wow zoomIn" data-wow-delay="0.2s">
                        <h5 class="mb-4"><i class="fa fa-reply text-primary me-3"></i>Reply within 24 hours</h5>
                    </div>
                    <div class="col-sm-6 wow zoomIn" data-wow-delay="0.4s">
                        <h5 class="mb-4"><i class="fa fa-phone-alt text-primary me-3"></i>24 hrs telephone support</h5>
                    </div>
                </div>
                <p class="mb-4">
                    At AbiaSoft Limited, we value your time. That’s why we guarantee a reply
                    within 24 hours to all inquiries. For urgent matters, our 24-hour telephone
                    support ensures you can always reach a professional staff member ready to
                    assist. With award-winning expertise and a commitment to transparency,
                    we’re here whenever you need us.
                </p>
                <div class="d-flex align-items-center mt-2 wow zoomIn" data-wow-delay="0.6s">
                    <div class="bg-primary d-flex align-items-center justify-content-center rounded" style="width: 60px; height: 60px;">
                        <i class="fa fa-phone-alt text-white"></i>
                    </div>
                    <div class="ps-4">
                        <h5 class="mb-2">Call to ask any question</h5>
                        <h4 class="text-primary mb-0">+91-8595-42-8595</h4>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="bg-primary rounded h-100 d-flex align-items-center p-5">
                    <form method="post" id="quoteForm" class="w-100">
                        @if (TempData["AlertMessage"] is string alertMessage)
                        {
                            var alertClass = TempData["AlertType"]?.ToString() == "success" ? "alert-success" : "alert-danger";
                            <div class="alert @alertClass" role="alert" aria-live="polite">@alertMessage</div>
                        }
                        <h4 class="text-white text-center mb-4">Request A Quote</h4>

                        <div class="mb-3">
                            <input asp-for="Quote.Name" class="form-control border-0 py-3" placeholder="Your Name" required />
                            <span asp-validation-for="Quote.Name" class="text-warning small"></span>
                        </div>

                        <div class="mb-3">
                            <input asp-for="Quote.Email" class="form-control border-0 py-3" placeholder="Your Email" type="email" required />
                            <span asp-validation-for="Quote.Email" class="text-warning small"></span>
                        </div>

                        <div class="mb-3">
                            <select asp-for="Quote.Service" class="form-select border-0 py-3" required>
                                <option value="">Select Service</option>
                                <option>Web Development</option>
                                <option>Mobile App</option>
                                <option>Software Development</option>
                            </select>
                            <span asp-validation-for="Quote.Service" class="text-warning small"></span>
                        </div>

                        <div class="mb-3">
                            <textarea asp-for="Quote.Message" class="form-control border-0 py-3"
                                      rows="4" placeholder="Message" required></textarea>
                            <span asp-validation-for="Quote.Message" class="text-warning small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark py-3">
                                Submit Request
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Quote End -->
